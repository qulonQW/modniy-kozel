# Copy to /opt/tovarka/.env on the server (next to compose.yaml), chmod 600.
# Never commit it.

# Host name for HTTPS. No domain? For IP 203.0.113.7 use 203-0-113-7.sslip.io
SHOP_HOST=203-0-113-7.sslip.io

# Which shop: a folder in brands/
BRAND=modniy-kozel

# From @BotFather
BOT_TOKEN=

# Numeric Telegram IDs of admins, comma-separated
ADMIN_TELEGRAM_IDS=

# Where the database and photos live on the server (default /srv/tovarka)
# DATA_DIR=/srv/tovarka
