# Installed by deploy/setup.sh as /etc/caddy/Caddyfile (SHOP_HOST replaced).
# Caddy gets and renews the Let's Encrypt certificate by itself; ports 80 and
# 443 must be open. The app compresses its own responses. No access log here:
# uvicorn logs method, path and status to journald (never headers or bodies).
SHOP_HOST {
	request_body {
		max_size 6MB
	}
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
