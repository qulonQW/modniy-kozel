# Copy to backend/.env and fill in. Never commit backend/.env.

# dev | prod
ENV=dev

# Which shop this is: a folder in brands/ (name, logo, colours, texts).
BRAND=modniy-kozel

# Token from @BotFather for the shop's bot. Required unless ENV=dev with DEV_ADMIN_ID.
BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed into the admin panel.
# Each of them also gets new-order messages from the bot: each admin must open
# the bot once and press Start, or Telegram refuses to deliver them.
ADMIN_TELEGRAM_IDS=111111111,222222222

# Dev only: act as this Telegram user ID without initData. Must be empty in prod
# (the app refuses to start with ENV=prod and DEV_ADMIN_ID set).
DEV_ADMIN_ID=

# The single origin allowed by CORS (the storefront/admin Mini App URL), no wildcard.
ALLOWED_ORIGIN=http://localhost:8000

# Optional overrides (defaults: backend/data/shop.sqlite3 and backend/uploads).
# DATABASE_PATH=
# UPLOADS_DIR=
